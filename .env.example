# ── General Production / Domain Settings ──────
DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=/api

# ── Database (PostgreSQL) ─────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=learnlens_automated_grading
DATABASE_URL=postgresql+asyncpg://postgres:generate_a_secure_password_here@postgres:5432/learnlens_automated_grading

# ── Security & Authentication ─────────────────
SECRET_KEY=generate_a_random_32_char_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── OCR / Tesseract ───────────────────────────
# In Docker or Linux VPS: leave empty or use /usr/bin/tesseract
# In Windows local dev: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ── Email / SMTP (Optional for Password Reset) ─
SHOW_DEV_RESET_LINK=False
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
