# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/learnlens
# MySQL / MariaDB (HostKoala / phpMyAdmin):
# DATABASE_URL=mysql+aiomysql://cpuser_learnlens:password@localhost:3306/cpuser_learnlens?charset=utf8mb4
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
